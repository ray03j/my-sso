# PostgreSQL
POSTGRES_USER=sso_user
POSTGRES_PASSWORD=sso_password
POSTGRES_DB=postgres

# Rails
RAILS_ENV=development
SECRET_KEY_BASE=replace_in_production
# JWT（access_token / id_token）の RS256 署名鍵（PEM）。改行は \n と書ける。
# 空なら開発・テストでは起動ごとに鍵を生成する（本番では必須）。生成例:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | awk '{printf "%s\\n", $0}'
JWT_PRIVATE_KEY=
INTERNAL_API_KEY=replace_in_production

# Internal service URLs
IDP_CLIENT_URL=http://localhost:3002
IDP_USER_VERIFY_URL=http://localhost:3001/api/v1/auth/verify
IDP_USER_URL=http://localhost:3001

# Frontend
VITE_API_BASE_URL=http://localhost:3000
